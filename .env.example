# Copy to .env at the repo root and fill in. Never commit .env.

# --- server ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/zatuna_interns
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- seed admin (used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@elzatuna.local
SEED_ADMIN_PASSWORD=Admin123!
